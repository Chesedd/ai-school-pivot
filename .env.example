# PostgreSQL container settings
POSTGRES_DB=content_bank
POSTGRES_USER=content_bank
POSTGRES_PASSWORD=change-me-for-local-development

# Async SQLAlchemy URL used by the backend and Alembic in Docker Compose.
DATABASE_URL=postgresql+asyncpg://content_bank:change-me-for-local-development@postgres:5432/content_bank
DATABASE_ECHO=false
# Temporary server-side actor until authentication is implemented.
# Temporary server-resolved pilot student identity (never accepted from requests).
ATTACHMENT_STORAGE_PATH=/data/attachments
ATTACHMENT_MAX_BYTES=5242880
ARTIFACT_STORAGE_PATH=/data/image-artifacts
CORS_ORIGINS=http://localhost:5173
# Pydantic duration syntax; D1 uses one absolute opaque-session lifetime.
AUTH_SESSION_TTL=PT12H
# Local HTTP override. Production should retain the Settings default of true and
# use the __Host- cookie name over HTTPS.
AUTH_SESSION_COOKIE_NAME=ai_school_session
AUTH_SESSION_COOKIE_SECURE=false
AUTH_SESSION_COOKIE_SAMESITE=lax
VITE_API_BASE_URL=http://localhost:8000

# Optional Anthropic-compatible Image Solving provider. Keep real credentials in
# your untracked .env file; the SDK appends its Messages API path to this base URL.
ANTHROPIC_BASE_URL=https://aiprimetech.io
ANTHROPIC_AUTH_TOKEN=
# Official Anthropic API-key authentication remains supported as an alternative.
ANTHROPIC_API_KEY=
IMAGE_SOLVING_ANTHROPIC_MODEL=claude-sonnet-4-6

# Scanned-paper deployment limits. Invalid relationships fail backend startup.
# The 25 MiB source and 25 megapixel security ceilings cannot be increased.
PAPER_MAX_ARTIFACTS_PER_BATCH=25
PAPER_MAX_TOTAL_UPLOAD_BYTES_PER_BATCH=262144000
PAPER_MAX_SINGLE_ARTIFACT_BYTES=26214400
PAPER_MAX_PAGES_PER_ARTIFACT=100
PAPER_MAX_PAGES_PER_BATCH=150
PAPER_MAX_PIXELS_PER_PAGE=25000000
PAPER_MAX_PAPER_SUBMISSIONS_PER_BATCH=60
PAPER_MAX_PAGES_PER_PAPER=20
PAPER_MAX_PARALLEL_MATCHING_RUNS=1
PAPER_MAX_PARALLEL_PAPER_CHECKS_PER_BATCH=3
PAPER_MAX_PARALLEL_PAPER_CHECKS_GLOBAL=12
PAPER_MAX_PROVIDER_PAGES_PER_PAPER=20
PAPER_MAX_PROVIDER_IMAGE_BYTES_PER_PAPER=26214400
PAPER_EXECUTION_LEASE_SECONDS=120

# Scanned-paper storage retention starts at explicit batch completion.
PAPER_SOURCE_RETENTION_DAYS=30
PAPER_UNPUBLISHED_PAGE_RETENTION_DAYS=30
PAPER_RETENTION_MAX_TARGETS_PER_RUN=100
PAPER_RETENTION_CLAIM_TTL_SECONDS=300

# Host ports
BACKEND_PORT=8000
FRONTEND_PORT=5173
POSTGRES_PORT=5432
