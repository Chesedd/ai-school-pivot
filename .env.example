# PostgreSQL container settings
POSTGRES_DB=content_bank
POSTGRES_USER=content_bank
POSTGRES_PASSWORD=change-me-for-local-development

# Async SQLAlchemy URL used by the backend and Alembic in Docker Compose.
DATABASE_URL=postgresql+asyncpg://content_bank:change-me-for-local-development@postgres:5432/content_bank
DATABASE_ECHO=false
# Temporary server-side actor until authentication is implemented.
CONTENT_BANK_DEV_ACTOR_ID=00000000-0000-4000-8000-000000000001
# Temporary server-resolved pilot student identity (never accepted from requests).
ASSESSMENT_DEV_STUDENT_ID=00000000-0000-4000-8000-000000000002
ATTACHMENT_STORAGE_PATH=/data/attachments
ATTACHMENT_MAX_BYTES=5242880
CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

# Host ports
BACKEND_PORT=8000
FRONTEND_PORT=5173
POSTGRES_PORT=5432
